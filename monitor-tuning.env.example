# Merge these values into your existing .env; preserve credentials/channels/DB_PATH.
# OS/container environment variables override .env and YAML.
# These are global defaults. Per-group overlays belong in config.yaml `groups:`.
POLL_INTERVAL_SECONDS=60
MAX_JITTER_SECONDS=10
INTER_CHANNEL_DELAY_SECONDS=2
DIGEST_MIN_CANDIDATES=12
DIGEST_MAX_WAIT_SECONDS=600
DIGEST_MIN_INTERVAL_SECONDS=180
DIGEST_MAX_BATCH_SIZE=20
DIGEST_MAX_CALLS_PER_DAY=288
NEWS_MAX_AGE_SECONDS=1800
HOTNESS_THRESHOLD=7
DIGEST_CARD_INTERVAL_SECONDS=10
TIMEZONE=Asia/Shanghai
SHOULDER_HOURS=22:00-00:00
QUIET_HOURS=00:00-08:00
SHOULDER_HOTNESS_THRESHOLD=8
SHOULDER_DIGEST_MIN_INTERVAL_SECONDS=600
SHOULDER_DIGEST_MIN_CANDIDATES=16
SHOULDER_DIGEST_CARD_INTERVAL_SECONDS=15
QUIET_HOTNESS_THRESHOLD=9
QUIET_DIGEST_MIN_INTERVAL_SECONDS=1800
QUIET_ALERT_INTERVAL_SECONDS=1800
QUIET_CARD_CAP=5
MORNING_FLUSH_HOTNESS_THRESHOLD=7
