# ==============================================================================
# Telegram News Monitor - Environment Variables Configuration Template
# Copy this file to .env and configure your secret credentials.
# ==============================================================================

# Target Telegram channels to monitor (comma-separated list, handles without @)
TELEGRAM_CHANNELS=durov,telegram,whale_alert

# Polling interval in seconds between cycles (minimum 5s, default 60s)
POLL_INTERVAL_SECONDS=60

# Maximum randomized jitter delay (seconds) added to interval to break timing fingerprints
MAX_JITTER_SECONDS=15

# Delay in seconds between polling consecutive channels
INTER_CHANNEL_DELAY_SECONDS=2.0

# ==============================================================================
# DeepSeek API Configuration (https://platform.deepseek.com/)
# ==============================================================================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Urgency / Newsworthiness Hotness Gating Threshold (1 - 10)
# Posts scoring >= HOTNESS_THRESHOLD trigger interactive Feishu alerts
HOTNESS_THRESHOLD=7

# Feishu (Lark) Custom Bot Webhook Configuration
# Obtain webhook URL from Feishu Group -> Bot Settings -> Custom Bot
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-bot-uuid-here

# Optional: Feishu Webhook HMAC-SHA256 signature verification secret
FEISHU_WEBHOOK_SECRET=

# SQLite Database Persistence Path
DB_PATH=data/tg_news.db

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional HTTP / HTTPS proxy for environments behind firewalls
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
