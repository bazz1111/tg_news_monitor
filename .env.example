# ==============================================================================
# Telegram News Monitor - Environment Variables Configuration Template
# Copy this file to .env and configure your secret credentials.
# ==============================================================================

# Target Telegram channels to monitor (comma-separated list, handles without @)
TELEGRAM_CHANNELS=durov,telegram,whale_alert

# Polling interval in seconds between cycles (minimum 5s, default 60s)
POLL_INTERVAL_SECONDS=300

# Maximum randomized jitter delay (seconds) added to interval to break timing fingerprints
MAX_JITTER_SECONDS=30

# Delay in seconds between polling consecutive channels
INTER_CHANNEL_DELAY_SECONDS=2.0

# ==============================================================================
# DeepSeek API Configuration (https://platform.deepseek.com/)
# ==============================================================================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Urgency / Newsworthiness Hotness Gating Threshold (1 - 10)
# Posts scoring >= HOTNESS_THRESHOLD trigger interactive Feishu alerts
HOTNESS_THRESHOLD=7

# Digest buffering: wait until N pending candidates OR oldest age exceeds max wait
# Gate opens when candidate count >= DIGEST_MIN_CANDIDATES, or oldest pending age
# exceeds DIGEST_MAX_WAIT_SECONDS (whichever first).
DIGEST_MIN_CANDIDATES=3
DIGEST_MAX_WAIT_SECONDS=900
# Seconds between Feishu single cards in the same digest batch (default 10)
DIGEST_CARD_INTERVAL_SECONDS=10

# Elastic quiet hours (local clock). Windows are [start, end) and may wrap midnight.
# Scraping continues 24/7; only Feishu digest send/eval knobs change.
TIMEZONE=Asia/Shanghai
SHOULDER_HOURS=23:00-01:00
QUIET_HOURS=01:00-08:00
SHOULDER_HOTNESS_THRESHOLD=8
SHOULDER_DIGEST_MIN_INTERVAL_SECONDS=600
SHOULDER_DIGEST_MIN_CANDIDATES=16
SHOULDER_DIGEST_CARD_INTERVAL_SECONDS=15
QUIET_HOTNESS_THRESHOLD=9
QUIET_DIGEST_MIN_INTERVAL_SECONDS=1800
QUIET_DIGEST_MIN_CANDIDATES=16
QUIET_DIGEST_CARD_INTERVAL_SECONDS=15
QUIET_CARD_CAP=5
MORNING_FLUSH_ENABLED=true
MORNING_FLUSH_MAX_AGE_SECONDS=7200
MORNING_FLUSH_HOTNESS_THRESHOLD=7
MORNING_FLUSH_CARD_INTERVAL_SECONDS=10

# Crypto/blockchain posts are ALWAYS banned in code (local coarse filter + post-digest
# hard drop). There is no env toggle; crypto content never reaches Feishu cards.

# Feishu (Lark) Custom Bot Webhook Configuration
# Obtain webhook URL from Feishu Group -> Bot Settings -> Custom Bot
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-bot-uuid-here

# Optional: Feishu Webhook HMAC-SHA256 signature verification secret
FEISHU_WEBHOOK_SECRET=

# SQLite Database Persistence Path
DB_PATH=data/tg_news.db

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional HTTP / HTTPS proxy for environments behind firewalls
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
