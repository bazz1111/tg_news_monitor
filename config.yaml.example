# ==============================================================================
# Telegram News Monitor - YAML Configuration Alternative Template
# Copy this file to config.yaml and configure your settings.
# Do not put real webhook URLs or API keys in a committed file.
# ==============================================================================

# Peer-equal groups. Once `groups` is present it is the primary source;
# TELEGRAM_CHANNELS is not used as the runtime channel list.
groups:
  - id: news24
    name: 7x24 新闻
    enabled: true
    channels:
      - zaobaosg
      - cnalatest
      - solidot
    webhook_url_env: FEISHU_WEBHOOK_NEWS24
    webhook_secret_env: FEISHU_WEBHOOK_SECRET_NEWS24
    # Optional per-group overlays (omit to inherit global knobs below)
    # quiet_hours: "00:00-08:00"
    # shoulder_hours: "22:00-00:00"
    # hotness_threshold: 7
    # digest_min_candidates: 12
    # digest_max_wait_seconds: 600
    # digest_min_interval_seconds: 180
    # digest_card_interval_seconds: 10
    # quiet_card_cap: 5
    # morning_flush_enabled: true
    # morning_flush_hotness_threshold: 7
    # digest_max_calls_per_day: 120
    card_profile:
      subtitle: 投资情报快报
      include_investment_impact: true
      prompt_variant: news
      # prompt_overlay: "额外评估约束（追加到 digest system prompt）"
      # embed_images: true  # 预留：同一飞书应用上传；目前仅 wechat_photo 发送路径会嵌入

  # WeChat 公众号历史影像素材桌：TG 公开频道进料，飞书审稿，人工再发公众号。
  # 低频：只在过本地安全阀 + 模型选中后推送。以下旋钮可按组改，稍后可再调。
  - id: old_photos
    name: 公众号历史图片素材
    enabled: true
    channels:
      - ussrpictures
      - pfff_history
      - whichtimes
      - old_history_photos
      - historicalpictures
      - record_history
      - Discoveryzhongwen
      - sovietvisuals
      # 历史光影档案馆：中国向历史影像（寺庙、拉卜楞/卓尼等）。t.me/s/fengls7 公开图文预览。
      # 陵墓/宫殿/遗址向专用公开 TG 很少，多数在微博等平台，故只加这一路已核验频道。
      - fengls7
    webhook_url_env: FEISHU_WEBHOOK_OLD_PHOTOS
    webhook_secret_env: FEISHU_WEBHOOK_SECRET_OLD_PHOTOS
    # 空字符串 = 本组关闭静默/过渡窗口（不继承全局）；省略字段才继承
    quiet_hours: ""
    shoulder_hours: ""
    morning_flush_enabled: false
    # 频道帖可在池中等待评估（默认 30 分钟会在 1 小时冷却里过期）
    news_max_age_seconds: 86400
    hotness_threshold: 7
    digest_min_candidates: 2
    digest_max_wait_seconds: 7200          # 不足 2 条时最多等 2 小时再评估
    digest_min_interval_seconds: 3600      # 模型最小间隔 1 小时
    digest_max_calls_per_day: 8            # 本组每日软上限；全局 DIGEST_MAX_CALLS_PER_DAY 仍是硬顶
    digest_max_batch_size: 8
    digest_card_interval_seconds: 15
    card_profile:
      subtitle: 公众号图片素材
      include_investment_impact: false
      prompt_variant: wechat_photo
      embed_images: true   # default for wechat_photo; needs FEISHU_APP_ID/SECRET

  # Example extra pipeline — leave disabled/empty until channels exist.
  - id: xhs_hot
    name: 小红书热点（示例）
    enabled: false
    channels: []
    webhook_url_env: FEISHU_WEBHOOK_XHS
    webhook_secret_env: FEISHU_WEBHOOK_SECRET_XHS
    card_profile:
      subtitle: 故事速览
      include_investment_impact: false
      prompt_variant: story

# Id used when synthesizing a group from TELEGRAM_CHANNELS + FEISHU_WEBHOOK_URL
# (only if this file has no `groups` key). Also used when migrating old SQLite rows.
# legacy_group_id: legacy

# Ingestion Polling Interval & Timing Defenses
poll_interval_seconds: 60
max_jitter_seconds: 15
inter_channel_delay_seconds: 2.0

# CodeBuddy CLI evaluator. Prefer CODEBUDDY_* in .env; do not commit the API key.
# Do not set CODEBUDDY_INTERNET_ENVIRONMENT (international site).
# codebuddy_model: deepseek-v4.1-flash
# codebuddy_fallback_model: hy3
# codebuddy_effort: max
# codebuddy_autocompact: auto
# codebuddy_timeout: 300.0

# Global defaults (groups inherit unless they override)
hotness_threshold: 7
timezone: Asia/Shanghai
shoulder_hours: "22:00-00:00"
quiet_hours: "00:00-08:00"
quiet_alert_interval_seconds: 1800
quiet_card_cap: 5
digest_max_calls_per_day: 288

# Persistent Storage & Runtime Logging
db_path: "data/tg_news.db"
log_level: "INFO"

# --- Legacy single-list (used only when `groups` is omitted) ---
# telegram_channels:
#   - durov
#   - telegram
# feishu_webhook_url: ""
# feishu_webhook_secret: ""
